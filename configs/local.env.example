# This machine's folders and cluster settings for r2s. Copy, then fill in:
#
#   cp configs/local.env.example configs/local.env      # gitignored
#
# scripts/env.sh loads configs/local.env. A variable already set in the environment
# keeps its value, so `R2S_EDEN=/other/Eden source scripts/env.sh` still works.
# Format: KEY=value, one per line, starting at the first column. Comments go on
# their own lines. Quote values with spaces or ';'. A value may use a variable set
# on an earlier line. `r2s doctor` reports every folder that is missing.

# ---- Needed by every command ------------------------------------------------

# Large writable folder: run outputs (runs/<name>/), the Python env (envs/eden),
# build caches (cache/) and Slurm logs (logs/).
R2S_WORK_ROOT=/path/to/real2sim_work

# Eden checkout, branch robotarena360 (read only). See README.md "Dependencies".
R2S_EDEN=/path/to/Eden

# CUDA 13.0 toolkit (torch 2.11 is built for it), used once to build gsplat's CUDA kernels.
CUDA_HOME=/usr/local/cuda-13.0

# Existing scene data in the scene_generation layout:
# DROID/<scene>/, scene_background/<scene>/, assets/<scene>/ (read only).
R2S_DATA=/path/to/scene_generation/data

# One generated 3DGS splat per scene, <scene>.ply (input of world.import).
R2S_SPLAT_SOURCE_DIR=/path/to/splats

# ---- Code and models used by some steps (read only) -------------------------

# scene_generation checkout: LaMa + big-lama weights, InvSR, MINIMA weights, LightGlue (step 0).
R2S_SCENE_GENERATION=/path/to/scene_generation
# sam-3d-objects checkout with checkpoints/hf (inputs.meshes).
R2S_SAM3D_OBJECTS=/path/to/sam-3d-objects
# Conda install holding the step-0 model envs gemini, invsr, lama, sam3d-objects, match, moge.
R2S_CONDA_ROOT=/path/to/miniconda3
# Layout refiner runs: the reviewed object layouts objects.freeze copies.
R2S_LAYOUT_REFINER=/path/to/scene_layout_refiner
# Task notes with object size priors (objects.refine).
R2S_TASKS_DIR=/path/to/manip-eureka-droid/v2/tasks

# ---- Slurm (scripts/slurm/submit.sh) ----------------------------------------

# Leave a setting empty to use the cluster's default.
R2S_SLURM_PARTITION=
R2S_SLURM_QOS=
R2S_SLURM_ACCOUNT=
# GPU request for the GPU steps; name a type if your cluster has several (gpu:<type>:1).
R2S_SLURM_GRES=gpu:1

# ---- Old-repo comparison (tools/legacy only; leave empty otherwise) ---------

# scene_gaussian_alignment checkout and the old echo2 asset folder.
R2S_OLD_REPO=
R2S_OLD_ECHO2=
# Old outputs recorded absolute paths through another mount of the same data:
# "OLD_PREFIX=NEW_PREFIX", several separated by ';' (quote the value).
R2S_OLD_PATH_ALIASES=
